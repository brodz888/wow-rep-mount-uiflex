# Copy to .env.local (gitignored) and fill in real values.
# Get a client ID/secret at https://develop.battle.net
# Register BOTH redirect URIs there (localhost for dev, real domain for prod)
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
BLIZZARD_REGION=us
BLIZZARD_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Session secret for signing login cookies (any long random string)
SESSION_SECRET=

# Database connection string (Vercel Postgres / Neon / etc.)
DATABASE_URL=
